<?xml version="1.0" encoding="utf-8"?>
<!--
    PermSense keeps an encrypted audit ledger of every app's sensitive access. It must never leave
    the device through backup: the key that opens it lives in this device's Keystore and cannot be
    restored elsewhere, and the file itself would sit in cloud storage.
    Backup is also switched off in the manifest; these rules are the second lock.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
